# Copy this file to .env on YOUR PC only (never commit .env). In the cloud,
# the same names go into GitHub > Settings > Secrets and variables > Actions.

# --- Google: YouTube + Google Drive (Viceverified.HQ@gmail.com) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
YOUTUBE_PRIVACY=public

# --- Instagram (Business/Creator account) ---
IG_USER_ID=
IG_ACCESS_TOKEN=

# --- Cloudflare R2 (temporary public link Instagram needs) ---
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=viceverified-media
R2_PUBLIC_BASE_URL=https://pub-xxxxxxxx.r2.dev

# --- TikTok ---
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REFRESH_TOKEN=
# direct = post to profile (private only until TikTok audits your app)
# inbox  = draft lands in your TikTok app, you tap Post (public right away)
TIKTOK_MODE=direct

# --- Your Qwen 3 on Cloudflare Workers AI (writes captions) ---
CF_ACCOUNT_ID=
CF_API_TOKEN=
QWEN_MODEL=@cf/qwen/qwen3.8-27b
